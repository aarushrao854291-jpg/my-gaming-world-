box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  background: #0d0b1b;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 {
  color: #00eaff;
  font-size: 30px;
  text-shadow: 0 0 15px #00eaff;
}

.game {
  background: #252344;
  margin: 30px auto;
  padding: 25px;
  max-width: 600px;
  border-radius: 25px;
  box-shadow: 0 0 20px #7900ff;
}

.game h2 {
  color: #ffcc00;
  font-size: 30px;
}

.game img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 15px;
}

.game p {
  font-size: 20px;
}

.play-btn {
  display: inline-block;
  background: linear-gradient(90deg, #7900ff, #00d9ff);
  color: white;
  padding: 15px 30px;
  border-radius: 12px;
  text-decoration: none;
  font-size: 20px;
  font-weight: bold;
  margin-top: 15px;
}
